# ronin-issen umbrella — a DOCS-ONLY git.
# It tracks the fleet governance docs at the umbrella root
# (CLAUDE.md = fleet constitution, README.md = canonical component layout, docs/).
#
# The forensic-fleet repos live under components/<category>/<repo> and _deprecated/<repo>
# as their OWN independent git repos — they are NEVER tracked here. Tracking them would make
# this a monorepo/workspace, which the umbrella design explicitly rejects (ADR-0017).
/components/
/_deprecated/

# OS / editor cruft
.DS_Store

# Session scratch: agent worktrees and transcripts. Never governance content.
.claude/
